generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTIONIST
  DENTIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  BLOCKED
}

enum PaymentType {
  DEPOSIT // Apartado/Abono
  FULL_PAYMENT
  BALANCE_SETTLEMENT
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  role      Role     @default(RECEPTIONIST)
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dentistProfile Dentist?
}

model Dentist {
  id        String  @id @default(cuid())
  name      String
  email     String?
  phone     String?
  specialty String?
  color     String  @default("#3b82f6") // For calendar visualization
  commissionPercentage Int    @default(0)

  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  appointments Appointment[]
  payments     Payment[]
  expenses     Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id         String    @id @default(cuid())
  name       String
  email      String?
  phone      String?
  homePhone  String?
  gender     String?
  occupation String?
  address    String?
  birthDate  DateTime?
  notes      String?
  tutorName  String?
  tutorPhone String?

  appointments   Appointment[]
  payments       Payment[]
  medicalHistory MedicalHistory?
  odontogram     OdontogramCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultory {
  id          String  @id @default(cuid())
  name        String // e.g., "Consultorio 1"
  description String?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  name        String
  category    String  @default("General") // To group variants
  description String?
  price       Decimal @db.Decimal(10, 2)
  duration    Int // Duration in minutes

  appointments Appointment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?

  dentist   Dentist @relation(fields: [dentistId], references: [id])
  dentistId String

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  consultory   Consultory @relation(fields: [consultoryId], references: [id])
  consultoryId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id               String        @id @default(cuid())
  amount           Decimal       @db.Decimal(10, 2)
  date             DateTime      @default(now())
  type             PaymentType
  method           PaymentMethod
  commission       Decimal       @default(0) @db.Decimal(10, 2)
  commissionPaid   Boolean       @default(false)
  invoiceRequested Boolean       @default(false)
  invoiceSent      Boolean       @default(false)
  notes            String?

  patient   Patient @relation(fields: [patientId], references: [id])
  patientId String

  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  appointmentId String?

  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  dentist   Dentist? @relation(fields: [dentistId], references: [id])
  dentistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(10, 2)
  description String
  date        DateTime @default(now())
  category    String // PAGO_DENTISTA, GASTO_OPERATIVO, etc.

  dentist   Dentist? @relation(fields: [dentistId], references: [id])
  dentistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicalHistory {
  id                 String   @id @default(cuid())
  patientId          String   @unique
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  consultationReason String?

  // Afecciones (booleanos)
  allergies            Boolean @default(false)
  heartProblems        Boolean @default(false)
  hypertension         Boolean @default(false)
  hypotension          Boolean @default(false)
  venerealDiseases     Boolean @default(false)
  rheumaticFever       Boolean @default(false)
  hepatitis            Boolean @default(false)
  ulcers               Boolean @default(false)
  headache             Boolean @default(false)
  hiv                  Boolean @default(false)
  epilepsy             Boolean @default(false)
  arthritis            Boolean @default(false)
  cancer               Boolean @default(false)
  diabetes             Boolean @default(false)
  nervousAlterations   Boolean @default(false)
  renalAlterations     Boolean @default(false)
  sinusitis            Boolean @default(false)
  pregnancy            Boolean @default(false)
  otherConditions      String?

  // Cuestionario adicional
  underMedicalTreatment Boolean @default(false)
  medicalTreatmentDetails     String?

  smokes              Boolean @default(false)
  smokesWhat          String? 
  smokesHowMuch       String?

  lastDentalVisit     String?
  referralSource      String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OdontogramCondition {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  toothId   Int      
  type      String   @default("ADULT") 
  condition String   
  notes     String?  
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, toothId, type])
}
